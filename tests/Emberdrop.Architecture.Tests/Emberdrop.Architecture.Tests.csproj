<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The assemblies whose shape is checked. Core and the providers are referenced so the test can show the dependencies point the right way. -->
    <ProjectReference Include="..\..\src\Emberdrop.Hosting\Emberdrop.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Emberdrop.Core\Emberdrop.Core.csproj" />
    <ProjectReference Include="..\..\src\Emberdrop.InMemory\Emberdrop.InMemory.csproj" />
    <ProjectReference Include="..\..\src\Emberdrop.Hangfire\Emberdrop.Hangfire.csproj" />
    <ProjectReference Include="..\..\src\Emberdrop.Storage.Relational\Emberdrop.Storage.Relational.csproj" />
    <ProjectReference Include="..\..\src\Emberdrop.Storage.Sqlite\Emberdrop.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Emberdrop.Storage.SqlServer\Emberdrop.Storage.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
